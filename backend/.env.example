# Copy this file to backend/.env and fill in real values. Never commit .env.
# Get API_ID and API_HASH from https://my.telegram.org.

# Telegram API ID (integer).
API_ID=12345678
# Telegram API hash paired with API_ID.
API_HASH=your_api_hash_here
# Phone number for Telegram login, E.164 format (e.g. +919876543210).
PHONE_NUMBER=+911234567890
# Comma-separated channel/chat IDs to scrape.
CHANNELS=-1001234567890,-1009876543210

# OPTIONAL — only for headless runs (GitHub Actions). Leave unset locally so the
# on-disk swarnsports_session file is used instead. Generate with:
#   cd backend && python generate_session.py
# then store the output as the GitHub secret SESSION_STRING (do not put it here).
# SESSION_STRING=
